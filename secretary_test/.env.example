# 경고: EXPO_PUBLIC_ 접두사가 붙은 환경변수는 빌드 시 클라이언트 앱 번들(APK/IPA)에
# 평문으로 그대로 포함되어 누구나 추출 가능합니다. 여기에 실제 API 키를 넣지 마세요.
# 프로덕션에서는 서버 프록시를 경유하거나 사용자별 SecureStore 입력 방식을 사용하세요.
EXPO_PUBLIC_GROQ_API_KEY=your_api_key_here

# Supabase - URL과 anon key는 RLS(Row Level Security)가 실질 보안 경계이므로
# 클라이언트에 노출되어도 안전합니다 (EXPO_PUBLIC_ 접두사로 번들에 포함됨).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# 절대 EXPO_PUBLIC_ 접두사를 붙이지 마세요 (앱 번들에 포함되면 안 되는 관리자 키).
# .env.local에만 넣고, supabase/seed.js 같은 로컬 1회성 스크립트에서만 사용하세요.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
